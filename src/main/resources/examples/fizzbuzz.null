let mod = fn(a, b) { a - (a / b) * b };

let fizzbuzz_one = fn(n) {
  if (mod(n, 15) == 0) {
    puts("FizzBuzz")
  } else {
    if (mod(n, 5) == 0) {
      puts("Buzz")
    } else {
      if (mod(n, 3) == 0) {
        puts("Fizz")
      } else {
        puts(n)
      }
    }
  }
};

let fizzbuzz = fn(n, max) {
  fizzbuzz_one(n);
  if (n < max) {
    fizzbuzz(n + 1, max)
  } else {
    0
  }
};

puts("FizzBuzz 1 to 30:");
fizzbuzz(1, 30);
puts("");
